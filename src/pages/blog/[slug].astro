---
import { decodeSlug, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import { ArrowLeft } from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import CodeBlock from "../../components/CodeBlock.astro";

const AUTHOR = "Martin Høst Normark";

// Entry types come from emdash-env.d.ts, generated from the collection schema.
const slug = decodeSlug(Astro.params.slug);
const { entry: post, error } = slug
  ? await getEmDashEntry("posts", slug)
  : { entry: undefined, error: undefined };

// A 404 response with an empty body makes Astro render src/pages/404.astro.
if (error || !post) {
  return new Response(null, { status: 404 });
}

const date = new Date(post.data.date);
const tags = post.data.terms?.tag ?? [];
---

<Layout
  title={post.data.title}
  description={post.data.excerpt}
  content={{ collection: "posts", id: post.data.id, slug: post.id }}
  pageType="article"
  articleMeta={{
    publishedTime: date.toISOString(),
    modifiedTime: post.data.updatedAt ? new Date(post.data.updatedAt).toISOString() : null,
    author: AUTHOR,
  }}
>
  <main class="flex-grow max-w-2xl mx-auto px-6 py-16 md:py-24">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-xs font-mono text-muted-foreground hover:text-primary transition-colors duration-300 mb-10"
    >
      <ArrowLeft class="h-3 w-3" />
      back
    </a>

    <article>
      <header class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-4">
          {post.data.title}
        </h1>

        <div class="flex items-center gap-3 mb-4">
          <img
            src="/avatar.jpeg"
            alt={AUTHOR}
            class="w-8 h-8 rounded-full ring-1 ring-border"
          />
          <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground">
            <span>{AUTHOR}</span>
            <span class="text-border">/</span>
            <time datetime={date.toISOString()}>
              {date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </div>
        </div>

        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mb-6">
              {tags.map((tag) => (
                <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded border border-border text-muted-foreground">
                  {tag.label}
                </span>
              ))}
            </div>
          )
        }

        {
          post.data.excerpt && (
            <p class="text-lg text-foreground/60 leading-relaxed">{post.data.excerpt}</p>
          )
        }
      </header>

      <hr class="border-border/30 mb-8" />

      <div class="prose prose-lg max-w-none">
        <PortableText value={post.data.content ?? []} components={{ type: { code: CodeBlock } }} />
      </div>
    </article>
  </main>
</Layout>
