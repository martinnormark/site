---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro";
import { ArrowUpRight } from "lucide-astro";

const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const elsewhere = [
  { label: "GitHub", href: "https://github.com/martinnormark" },
  { label: "X / Twitter", href: "https://x.com/martinhn" },
  { label: "LinkedIn", href: "https://linkedin.com/in/martinhn" },
];

// Structured data for the home page as an author profile. EmDashHead adds
// the WebSite node; this describes the person behind it.
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: new URL("/", siteUrl).href,
  mainEntity: {
    "@type": "Person",
    name: "Martin Høst Normark",
    jobTitle: "Principal Software Engineer",
    worksFor: { "@type": "Organization", name: "The LEGO Group" },
    url: new URL("/", siteUrl).href,
    image: new URL("/avatar.jpeg", siteUrl).href,
    sameAs: elsewhere.map((link) => link.href),
  },
};
---

<Layout>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(profile)} />
  <main class="flex-grow max-w-2xl mx-auto px-6 py-16 md:py-24">
    <div class="animate-fade-in-up">
      <div class="flex items-center gap-5 mb-10">
        <Avatar size={64} class="w-16 h-16 rounded-full ring-2 ring-border" />
        <div>
          <h1 class="text-xl font-bold tracking-tight">Martin Høst Normark</h1>
          <p class="text-sm text-muted-foreground font-mono">engineering the uncertain</p>
        </div>
      </div>
    </div>

    <div class="animate-fade-in-up delay-1 space-y-4 mb-12">
      <p class="text-foreground/80 leading-relaxed">
        Principal Software Engineer at The LEGO Group. I build scalable systems,
        tinker with machine learning, and bring statistical rigor to complex problems.
        Generalist at heart — from cloud architecture to data science to UX.
      </p>
      <p class="text-foreground/80 leading-relaxed">
        Exploring the space where software craft meets uncertainty.
      </p>
    </div>

    <div class="animate-fade-in-up delay-2 mb-14">
      <h2 class="text-xs font-mono text-muted-foreground uppercase tracking-widest mb-4">Currently into</h2>
      <ul class="flex flex-wrap gap-2">
        {[
          "ML/AI", "Cloud Architecture", "Full-Stack", "Data Science",
          "Probabilistic Thinking", "API Design", "Prototyping"
        ].map(skill => (
          <li class="text-xs font-mono px-3 py-1.5 rounded-full border border-border text-muted-foreground hover:text-primary hover:border-primary/40 transition-colors duration-300 cursor-default">
            {skill}
          </li>
        ))}
      </ul>
    </div>

    <div class="animate-fade-in-up delay-3 space-y-3">
      <h2 class="text-xs font-mono text-muted-foreground uppercase tracking-widest mb-4">Elsewhere</h2>
      <ul class="flex flex-col gap-2">
        {
          elsewhere.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-2 text-sm text-foreground/70 hover:text-primary transition-colors duration-300"
              >
                <span>{link.label}</span>
                <ArrowUpRight
                  aria-hidden="true"
                  class="h-3 w-3 opacity-0 -translate-y-0.5 translate-x-0.5 group-hover:opacity-100 group-hover:translate-y-0 group-hover:translate-x-0 transition-all duration-300"
                />
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/blog"
        class="inline-block text-sm text-primary hover:text-primary/80 transition-colors duration-300 mt-2"
      >
        Read the blog &rarr;
      </a>
    </div>
  </main>
</Layout>
